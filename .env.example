# Redis Eats Agentic Workshop — Environment Variables Example
# Copy to .env and fill in. The notebook uses paste variables — this file
# is provided for local development convenience only.

# Redis Cloud (same database as Workshop 1)
REDIS_CLI_COMMAND=redis-cli -u redis://default:yourpassword@your-host.db.redis.io:12345

# OpenAI
OPENAI_API_KEY=sk-...

# Redis Agent Memory (Redis Cloud → Context Engine → Agent Memory)
AGENT_MEMORY_URL=https://your-agent-memory-host.redis.io
AGENT_MEMORY_STORE_ID=your-store-id
AGENT_MEMORY_API_KEY=your-agent-memory-api-key

# Context Retriever / Context Surfaces (Redis Cloud → Context Engine → Context Retriever)
CONTEXT_SURFACES_URL=https://your-context-surfaces-host.redis.io
CONTEXT_SURFACES_ADMIN_KEY=your-admin-key
CONTEXT_SURFACES_AGENT_KEY=your-agent-key
CONTEXT_SURFACES_MCP_URL=https://your-mcp-host.redis.io

# LangCache (Redis Cloud → Context Engine → LangCache — same as Workshop 1)
LANGCACHE_URL=https://your-langcache-host.langcache.redis.io
LANGCACHE_CACHE_ID=your-cache-id
LANGCACHE_API_KEY=your-langcache-api-key
